# Vscode 安裝 REST Client
@baseUrl = http://localhost:3001/api
# @token = {{auth_token}}

### GET /api/user - 取得所有使用者
GET {{baseUrl}}/user

### GET /api/user/:id - 取得單一使用者
GET {{baseUrl}}/user/1

### POST /api/user - 建立一個新的使用者
POST {{baseUrl}}/user
Content-Type: application/json

{
  "username": "使用者",
  "is_active": true,
  "role": "normal",
  "password": "123"
}

### PUT /api/user/:id - 更新一個使用者
PUT {{baseUrl}}/user/1
Content-Type: application/json

{
  "username": "更新使用者",
  "role": "admin",
  "password": "admin"
}

### DELETE /api/user/:id - 刪除一個使用者
DELETE {{baseUrl}}/user/2



### POST /api/login - 登入
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "更新使用者",
    "password": "Password123"
}